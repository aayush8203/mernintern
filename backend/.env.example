# Server Environment
PORT=8080
NODE_ENV=production

# MongoDB Connection String (Atlas URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# JWT Settings
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE_IN=90d
JWT_COOKIE_EXPIRE_IN=90

# Frontend Allowed Origin (e.g. https://your-app.vercel.app or comma-separated list)
ORIGIN_ACCESS_URL=https://your-frontend-app-name.vercel.app

# ImageKit Configuration (for file uploads)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# Mailtrap / SMTP Settings (for password reset emails)
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=your_smtp_user
MAILTRAP_SMTP_PASSWORD=your_smtp_password

# Groq AI Key (for AI descriptions and trip planning)
GROQ_API_KEY=your_groq_api_key
